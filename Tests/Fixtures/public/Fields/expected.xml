<?xml version="1.0" ?>
<fmxmlsnippet type="FMObjectList">
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["Ada"]]></Calculation>
    <Field name="Name" table="Customers"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[$note]]></Calculation>
    <Field name="Note" table="Orders" repetition="3"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA["Paid"]]></Calculation>
    <Field name="Status" table="Invoices"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Get ( CurrentTimestamp )]]></Calculation>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[42]]></Calculation>
    <Field name="Total" table="Invoices"/>
  </Step>
  <Step enable="True" id="76" name="Set Field">
    <Calculation><![CDATA[Settings::Counter + 1]]></Calculation>
    <Field name="Counter" table="Settings"/>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <TargetName>
      <Calculation><![CDATA[$fieldName]]></Calculation>
    </TargetName>
    <Result>
      <Calculation><![CDATA[$value]]></Calculation>
    </Result>
  </Step>
  <Step enable="True" id="147" name="Set Field By Name">
    <TargetName>
      <Calculation><![CDATA["Customers::" & $field]]></Calculation>
    </TargetName>
    <Result>
      <Calculation><![CDATA[""]]></Calculation>
    </Result>
  </Step>
  <Step enable="True" id="77" name="Insert Calculated Result">
    <Calculation><![CDATA[Select]]></Calculation>
    <Calculation><![CDATA[Customers::Notes]]></Calculation>
    <Calculation><![CDATA["text"]]></Calculation>
  </Step>
  <Step enable="True" id="91" name="Replace Field Contents">
    <Withdialog>Off</Withdialog>
    <Calculation><![CDATA[Customers::Status]]></Calculation>
    <Replacewithcalculation>&quot;Active&quot;</Replacewithcalculation>
  </Step>
  <Step enable="True" id="116" name="Set Next Serial Value">
    <Calculation><![CDATA[Invoices::ID]]></Calculation>
    <Calculation><![CDATA[1000]]></Calculation>
  </Step>
</fmxmlsnippet>
